rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // For development, we allow authenticated users broad access,
    // but we can lock this down for production.
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager");
      
      // Admins can do anything
      // Regular users can only write to their own document, AND they cannot elevate their own role
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        (
          request.auth.uid == userId &&
          // Prevent role escalation (if creating, must be 'user'. If updating, role must not change)
          (!("role" in request.resource.data) || request.resource.data.role == "user" || (resource != null && request.resource.data.role == resource.data.role)) &&
          // Prevent self-verifying
          (!("verificationStatus" in request.resource.data) || request.resource.data.verificationStatus == "pending" || (resource != null && request.resource.data.verificationStatus == resource.data.verificationStatus))
        )
      );
    }

    // Aadhaar Registry (For duplicate checking)
    match /aadhaar_registry/{aadhaarNumber} {
      allow get: if request.auth != null; // Allow fetching specific aadhaar
      allow list: if false; // Prevent querying/scraping
      allow write: if request.auth != null; // Allow writing during onboarding
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true; // anyone can see open events
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Applications collection
    match /applications/{applicationId} {
      // Admins and managers can read all applications. Users can read only their own.
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager");
      
      // Users can create an application
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Admins and managers can update applications
      allow update: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager");
      
      // Only admins can delete applications
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Counters collection (used for generating BUP00001 IDs and Stats)
    match /counters/{counterId} {
      allow read: if true; // Public read for About page stats
      allow write: if request.auth != null;
    }

    // Settings collection (CMS content)
    match /settings/{document} {
      allow read: if true; // Public can read landing page content
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Email OTPs collection
    match /email_otps/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Stats Counter collection
    match /stats_counter/{document} {
      allow read: if true; // Public read
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
