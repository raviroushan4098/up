rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for roles
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isManager() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager";
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isManager());
      
      // Allow users to create their own document with default roles, but not as admin
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!("role" in request.resource.data) || request.resource.data.role == "user")
                    && (!("verificationStatus" in request.resource.data) || request.resource.data.verificationStatus == "pending");

      // Admins can update anything. Regular users can update their own doc but cannot escalate roles.
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          // Prevent role escalation
          // Prevent role escalation
          (!("role" in request.resource.data) || request.resource.data.role == resource.data.role) &&
          // Prevent self-verifying (Users can only set to pending or keep it the same)
          (!("verificationStatus" in request.resource.data) || 
           request.resource.data.verificationStatus == "pending" || 
           request.resource.data.verificationStatus == resource.data.get("verificationStatus", ""))
        )
      );

      // Only admins can delete a user
      allow delete: if isAdmin();
    }

    // Aadhaar Registry (For duplicate checking)
    match /aadhaar_registry/{aadhaarNumber} {
      allow get: if request.auth != null; // Allow fetching specific aadhaar during onboarding
      allow list: if false; // Prevent querying/scraping all aadhaars
      // Only allow creation, prevent overwrites, and uid must match
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; 
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true; // anyone can see events
      allow write: if isAdmin();
    }

    // Applications collection
    match /applications/{applicationId} {
      // Admins and managers can read all applications. Users can read only their own.
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin() || isManager());
      
      // Users can create an application for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Admins and managers can update applications (e.g. status)
      allow update: if isAdmin() || isManager();
      
      // Only admins can delete applications
      allow delete: if isAdmin();
    }

    // Counters collection (used for generating BUP00001 IDs and Stats)
    match /counters/{counterId} {
      allow read: if true; // Public read for About page stats
      
      // Allow creation/updates if incrementing stats
      allow create, update: if request.auth != null;
    }

    // Settings collection (CMS content)
    match /settings/{document} {
      allow read: if true; // Public can read landing page content
      allow write: if isAdmin();
    }

    // Email OTPs collection
    match /email_otps/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Stats Counter collection
    match /stats_counter/{document} {
      allow read: if true; // Public read
      allow write: if isAdmin();
    }

    // Dynamic QR Links collection
    match /dynamic_links/{linkId} {
      allow read: if true; // Anyone can read the redirect
      allow create, delete: if isAdmin();
      // Anyone can update the clicks counter, but only the clicks counter
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) &&
        request.resource.data.clicks == resource.data.clicks + 1
      );
    }
  }
}
